# ============================================================
# EVIDENTIAL — Environment Configuration
# ============================================================

# App Settings
PROJECT_NAME=EVIDENTIAL
APP_ENV=development
API_V1_STR=/api/v1
SECRET_KEY=evidential-super-secure-jwt-secret-key-change-in-production-2026!
ACCESS_TOKEN_EXPIRE_MINUTES=480
LOG_LEVEL=INFO

# Database Configuration
# For PostgreSQL: postgresql://evidential:evidential_secret_password@localhost:5432/evidential_db
# For Local Dev without Docker: sqlite:///./evidential.db
DATABASE_URL=sqlite:///./evidential.db

POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=evidential
POSTGRES_PASSWORD=evidential_secret_password
POSTGRES_DB=evidential_db

# File Storage
STORAGE_DIR=./storage
UPLOAD_DIR=./storage/uploads
EVIDENCE_DIR=./storage/evidence
OCR_DIR=./storage/ocr
MAX_FILE_SIZE_MB=50

# Frontend & CORS
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# AI & LLM Configuration (Optional - offline fallback enabled by default)
OPENAI_API_KEY=
GEMINI_API_KEY=
LLM_PROVIDER=offline
